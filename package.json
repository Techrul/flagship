{
  "name": "flagship",
  "version": "0.3.3",
  "description": "A launcher for Scratch games, powered by TurboWarp. Not affiliated with the Scratch Team.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "start": "node scripts/build.mjs --dev && electron .",
    "typecheck": "tsc",
    "test": "esbuild test/core.test.ts --bundle --platform=node --format=cjs --external:electron --outfile=.test-build/core.test.cjs --log-level=warning && node --test .test-build/core.test.cjs"
  },
  "author": "Techrul",
  "license": "MIT",
  "dependencies": {
    "@turbowarp/packager": "3.14.0",
    "@turbowarp/sbdl": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "45.4.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "private": true
}
